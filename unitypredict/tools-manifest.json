  "novel_features": [
    {
      "name": "All-logs fan-out for a request",
      "command": "logs get",
      "description": "One command fetches the per-request devLog, the runtime Log.txt, and the engine build log, in order."
    },
    {
      "name": "One-command long-description upload",
      "command": "models describe set",
      "description": "Publish a model's long description from a Markdown file in one step, including the S3 upload dance."
    },
    {
      "name": "Declarative inputs/outcomes",
      "command": "models io set",
      "description": "Define a model's input and outcome variables from a YAML file instead of the console's per-field editors."
    },
    {
      "name": "Reverse lookup: models per engine",
      "command": "engines models",
      "description": "List every model built on a given engine."
    },
    {
      "name": "Honest auth check",
      "command": "auth check",
      "description": "Validate credentials against the one endpoint that cannot lie about auth."
    },
    {
      "name": "Engine concurrency view",
      "command": "engines concurrency",
      "description": "Show how many engine nodes ran in parallel over time, as a table."
    },
    {
      "name": "Invoke, wait, download in one call",
      "command": "predict run",
      "description": "Invoke a model with text or file inputs, poll to completion, and pull File outcomes into a directory."
    },
    {
      "name": "Cross-environment diff",
      "command": "diff model",
      "description": "Compare a model or engine record across dev and prod, field by field."
    }
  ]
}
